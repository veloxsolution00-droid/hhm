# Offline-only local inference. Do not replace this with a hosted API URL.
OLLAMA_BASE_URL=http://127.0.0.1:11434
GENERATION_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text
TEMPERATURE=0.0
TIMEOUT=300
ANSWER_MAX_TOKENS=350
VERIFY_MAX_TOKENS=128

# Persistent local data. Keep this directory on a disk with sufficient free space.
DATA_PATH=./data
COLLECTION_NAME=document_chunks

# Structure-aware chunking (character counts, not tokenizer tokens).
CHUNK_SIZE=1200
CHUNK_OVERLAP=180

# Retrieval and evidence limits. Tune only against a labelled local evaluation set.
TOP_K=4
RETRIEVAL_CANDIDATE_MULTIPLIER=5
MIN_SIMILARITY=0.25
HYBRID_LEXICAL_WEIGHT=0.35
LEXICAL_CANDIDATE_LIMIT=40

# Local model resource controls.
EMBEDDING_BATCH_SIZE=16
INFERENCE_CONCURRENCY=1
INFERENCE_QUEUE_TIMEOUT_SECONDS=30

# Ingestion and resource limits.
MAX_FILE_MB=200
MAX_BATCH_MB=500
MAX_UPLOAD_FILES=50
INGESTION_WORKERS=4
MAX_PDF_PAGES=5000
MAX_IMAGE_PIXELS=40000000
EXTRACTION_BLOCK_ROWS=1000
MAX_ARCHIVE_UNCOMPRESSED_MB=256
MAX_ARCHIVE_COMPRESSION_RATIO=200
MAX_ARCHIVE_ENTRIES=10000
MAX_PENDING_JOBS=50
MAX_PENDING_UPLOAD_MB=1000
MAX_DATA_STORAGE_MB=20480

# OCR is local. Install Tesseract separately; no OCR binary is downloaded at runtime.
OCR_ENABLED=true
TESSERACT_CMD=C:\\Program Files\\Tesseract-OCR\\tesseract.exe
OCR_TIMEOUT_SECONDS=45

# Bounded prompt context.
MAX_CONTEXT_CHARS=16000
MODEL_CONTEXT_TOKENS=4096
CONTEXT_SAFETY_TOKENS=900
CONTEXT_CHARS_PER_TOKEN=3.5
MAX_QUESTION_PARTS=10

# Evidence verification and disposable local cache.
VERIFY_ANSWERS=true
CACHE_ENABLED=true
CACHE_TTL_SECONDS=604800
CACHE_MAX_ENTRIES=2000
SEMANTIC_RETRIEVAL_THRESHOLD=0.94
SEMANTIC_ANSWER_CACHE_ENABLED=false
SEMANTIC_ANSWER_THRESHOLD=0.975

# Startup reconciliation preserves durable user data.
RECOVERY_ON_STARTUP=true
